<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:MusicMixer.Desktop.Localization"
        xmlns:views="using:MusicMixer.Desktop.Views"
        x:Class="MusicMixer.Desktop.Views.MainWindow"
        Title="{loc:Localize Key=WindowTitle}"
        Width="1380"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        Icon="/Assets/MusicMixer.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}">
  <views:MainView />
</Window>
