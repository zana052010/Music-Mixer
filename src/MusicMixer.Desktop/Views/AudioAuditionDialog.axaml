<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicMixer.Desktop.Audition"
        xmlns:controls="using:MusicMixer.Desktop.Controls"
        xmlns:loc="using:MusicMixer.Desktop.Localization"
        x:Class="MusicMixer.Desktop.Views.AudioAuditionDialog"
        x:DataType="vm:AudioAuditionViewModel"
        x:CompileBindings="True"
        Title="{loc:Localize Key=AuditionTitle}"
        Width="880"
        Height="590"
        MinWidth="720"
        MinHeight="520"
        Icon="/Assets/MusicMixer.ico"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True"
        Background="{DynamicResource CanvasBrush}">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="28,20">
      <StackPanel Spacing="2">
        <TextBlock Text="{loc:Localize Key=AuditionEyebrow}" Classes="eyebrow" />
        <TextBlock Text="{loc:Localize Key=AuditionTitle}" Classes="dialog-title" />
      </StackPanel>
    </Border>

    <!-- Preview -->
    <Grid Grid.Row="1" Margin="28,20,28,0" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,14">
        <TextBlock Text="{Binding TrackTitle}"
                   Classes="section-heading"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subtitle}"
                   Classes="small muted"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding FileNameLabel}"
                   Classes="tiny faint"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Border Grid.Row="1" Classes="card" Padding="20">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Localize Key=AuditionSubtitle}"
                       Classes="small muted"
                       TextWrapping="Wrap"
                       MaxWidth="560"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding PlayheadTimeText}" Classes="mono" />
              <TextBlock Text="/" Classes="tiny faint" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DurationText}" Classes="mono muted" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Classes="inset" Margin="0,14,0,0" Padding="6,4">
            <controls:WaveformView Height="160"
                                   Seed="57"
                                   Peaks="{Binding Peaks}"
                                   Progress="{Binding PlayheadFraction}"
                                   LineBrush="{DynamicResource InkBrush}"
                                   PlayheadBrush="{DynamicResource InkBrush}"
                                   BaselineBrush="{DynamicResource DividerBrush}" />
          </Border>

          <Slider x:Name="AuditionSeekSlider"
                  Grid.Row="2"
                  Minimum="0"
                  Maximum="{Binding DurationSeconds}"
                  Value="{Binding PlayheadSeconds, Mode=TwoWay}"
                  Margin="0,6,0,0"
                  ToolTip.Tip="{loc:Localize Key=TooltipAuditionSeek}" />

          <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" Margin="0,14,0,0">
            <Button Classes="primary"
                    Content="{Binding PlayPauseText}"
                    Command="{Binding PlayPauseCommand}"
                    MinWidth="92" />
            <Button Grid.Column="1"
                    Classes="outline"
                    Content="{loc:Localize Key=Stop}"
                    Command="{Binding StopCommand}"
                    Margin="8,0,0,0" />
            <TextBlock Grid.Column="2"
                       Text="{loc:Localize Key=AuditionHint}"
                       Classes="tiny faint"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="18,0,0,0" />
          </Grid>

          <TextBlock Grid.Row="4"
                     Text="{Binding ErrorMessage}"
                     Classes="small"
                     IsVisible="{Binding HasError}"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0" />
        </Grid>
      </Border>
    </Grid>

    <!-- Actions -->
    <Border Grid.Row="2"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="28,14">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{loc:Localize Key=AuditionNotAdded}"
                   Classes="tiny faint"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="outline"
                Content="{loc:Localize Key=Cancel}"
                Command="{Binding CancelCommand}"
                Margin="12,0,0,0" />
        <Button Grid.Column="2"
                Classes="primary"
                Content="{loc:Localize Key=AuditionAdd}"
                Command="{Binding AddCommand}"
                Margin="8,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
