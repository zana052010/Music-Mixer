<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MusicMixer.Desktop</RootNamespace>
    <AssemblyName>MusicMixer</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Иконка генерируется из Assets\MusicMixer.ico.b64 перед сборкой (см. DecodeAppIcon). -->
    <ApplicationIcon>Assets\MusicMixer.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicMixer.Application\MusicMixer.Application.csproj" />
    <ProjectReference Include="..\MusicMixer.Domain\MusicMixer.Domain.csproj" />
    <ProjectReference Include="..\MusicMixer.Infrastructure\MusicMixer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Localization\Strings.en.json" />
    <AvaloniaResource Include="Localization\Strings.ru.json" />
    <AvaloniaResource Include="Assets\MusicMixer.ico" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\bin\ffmpeg.exe')">
    <None Include="..\..\tools\ffmpeg\bin\ffmpeg.exe" Link="tools\ffmpeg\bin\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\ffmpeg\bin\ffprobe.exe" Link="tools\ffmpeg\bin\ffprobe.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\bin\ffmpeg')">
    <None Include="..\..\tools\ffmpeg\bin\ffmpeg" Link="tools\ffmpeg\bin\ffmpeg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\ffmpeg\bin\ffprobe" Link="tools\ffmpeg\bin\ffprobe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\tools\bass\x64\bass.dll')">
    <None Include="..\..\tools\bass\x64\bass.dll" Link="bass.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    Иконка приложения хранится в git как base64-текст (Assets\MusicMixer.ico.b64),
    а настоящий .ico собирается здесь перед компиляцией. Исходник — Assets\icon.svg.
  -->
  <UsingTask TaskName="DecodeBase64File"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = System.IO.File.ReadAllText(SourceFile);
        var bytes = System.Convert.FromBase64String(text.Replace("\r", "").Replace("\n", "").Trim());
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(DestinationFile));
        System.IO.File.WriteAllBytes(DestinationFile, bytes);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="DecodeAppIcon"
          BeforeTargets="BeforeBuild;CoreCompile"
          Inputs="$(MSBuildProjectDirectory)\Assets\MusicMixer.ico.b64"
          Outputs="$(MSBuildProjectDirectory)\Assets\MusicMixer.ico">
    <DecodeBase64File SourceFile="$(MSBuildProjectDirectory)\Assets\MusicMixer.ico.b64"
                      DestinationFile="$(MSBuildProjectDirectory)\Assets\MusicMixer.ico" />
  </Target>
</Project>
