<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared typography. -->
  <FontFamily x:Key="AppFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

  <!-- Monochrome slider with a rectangular handle. -->
  <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
  <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
  <x:Double x:Key="SliderHorizontalThumbHeight">20</x:Double>
  <x:Double x:Key="SliderVerticalThumbWidth">20</x:Double>
  <x:Double x:Key="SliderVerticalThumbHeight">12</x:Double>
  <CornerRadius x:Key="SliderThumbCornerRadius">2</CornerRadius>

  <!-- Keep popup tooltips readable in both themes. -->
  <SolidColorBrush x:Key="ToolTipBackground" Color="#18181B" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="#FAFAFA" />
  <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3F3F46" />

  <ResourceDictionary.ThemeDictionaries>
    <!-- shadcn neutral light palette. -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="SystemAccentColor">#09090B</Color>
      <Color x:Key="SystemAccentColorLight1">#27272A</Color>
      <Color x:Key="SystemAccentColorLight2">#3F3F46</Color>
      <Color x:Key="SystemAccentColorLight3">#52525B</Color>
      <Color x:Key="SystemAccentColorDark1">#000000</Color>
      <Color x:Key="SystemAccentColorDark2">#000000</Color>
      <Color x:Key="SystemAccentColorDark3">#000000</Color>

      <SolidColorBrush x:Key="CanvasBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InsetBrush" Color="#F4F4F5" />
      <SolidColorBrush x:Key="InkBrush" Color="#09090B" />
      <SolidColorBrush x:Key="InkHoverBrush" Color="#27272A" />
      <SolidColorBrush x:Key="MutedInkBrush" Color="#71717A" />
      <SolidColorBrush x:Key="FaintInkBrush" Color="#A1A1AA" />
      <SolidColorBrush x:Key="BorderBrush" Color="#E4E4E7" />
      <SolidColorBrush x:Key="DividerBrush" Color="#F1F1F3" />
      <SolidColorBrush x:Key="HoverBrush" Color="#F4F4F5" />
      <SolidColorBrush x:Key="PressedBrush" Color="#E4E4E7" />
      <SolidColorBrush x:Key="InverseInkBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="DisabledInkBrush" Color="#A1A1AA" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#D4D4D8" />
      <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#18181B" />
      <SolidColorBrush x:Key="TextSelectionBrush" Color="#E4E4E7" />
      <SolidColorBrush x:Key="WaveformSelectionMaskBrush" Color="#B3FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackFill" Color="#E4E4E7" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#09090B" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#09090B" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#D4D4D8" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#27272A" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#27272A" />
      <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#E4E4E7" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#000000" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#000000" />
      <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#E4E4E7" />
      <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#A1A1AA" />
      <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#A1A1AA" />
      <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
      <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
      <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#09090B" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#09090B" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#E4E4E7" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#09090B" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#D4D4D8" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#09090B" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#09090B" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#E4E4E7" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#A1A1AA" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#A1A1AA" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#A1A1AA" />
    </ResourceDictionary>

    <!-- shadcn neutral dark palette. -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="SystemAccentColor">#FAFAFA</Color>
      <Color x:Key="SystemAccentColorLight1">#FFFFFF</Color>
      <Color x:Key="SystemAccentColorLight2">#E4E4E7</Color>
      <Color x:Key="SystemAccentColorLight3">#D4D4D8</Color>
      <Color x:Key="SystemAccentColorDark1">#A1A1AA</Color>
      <Color x:Key="SystemAccentColorDark2">#71717A</Color>
      <Color x:Key="SystemAccentColorDark3">#52525B</Color>

      <SolidColorBrush x:Key="CanvasBrush" Color="#09090B" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#0E0E10" />
      <SolidColorBrush x:Key="InsetBrush" Color="#18181B" />
      <SolidColorBrush x:Key="InkBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="InkHoverBrush" Color="#E4E4E7" />
      <SolidColorBrush x:Key="MutedInkBrush" Color="#A1A1AA" />
      <SolidColorBrush x:Key="FaintInkBrush" Color="#71717A" />
      <SolidColorBrush x:Key="BorderBrush" Color="#27272A" />
      <SolidColorBrush x:Key="DividerBrush" Color="#1F1F23" />
      <SolidColorBrush x:Key="HoverBrush" Color="#18181B" />
      <SolidColorBrush x:Key="PressedBrush" Color="#27272A" />
      <SolidColorBrush x:Key="InverseInkBrush" Color="#09090B" />
      <SolidColorBrush x:Key="DisabledInkBrush" Color="#52525B" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#141416" />
      <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#3F3F46" />
      <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#E4E4E7" />
      <SolidColorBrush x:Key="TextSelectionBrush" Color="#3F3F46" />
      <SolidColorBrush x:Key="WaveformSelectionMaskBrush" Color="#99000000" />
      <SolidColorBrush x:Key="SliderTrackFill" Color="#27272A" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FAFAFA" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#FAFAFA" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3F3F46" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E4E4E7" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E4E4E7" />
      <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#27272A" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#1F1F23" />
      <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#52525B" />
      <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#52525B" />
      <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
      <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
      <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FAFAFA" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#09090B" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#FAFAFA" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#0E0E10" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#27272A" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FAFAFA" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0E0E10" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3F3F46" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FAFAFA" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0E0E10" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FAFAFA" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#3F3F46" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#71717A" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#71717A" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#71717A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
